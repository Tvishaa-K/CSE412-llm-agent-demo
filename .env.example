# Copy this file to .env and fill in your own values.
# .env is gitignored. Never commit it.

# Gemini API key from https://aistudio.google.com (API Keys in the left nav)
GEMINI_API_KEY=your_key_here

# PostgreSQL connection for the read-only agent role.
# Use a socket directory or a hostname for DB_HOST.
DB_HOST=/tmp
DB_PORT=8888
DB_NAME=project_db
DB_USER=agent_ro
DB_PASSWORD=your_password_here
